@startuml

entity "USUARIO" as usuario {
  * id_usuario : VARCHAR(36) [PK]
  --
  * nombre : VARCHAR(100)
  * email_corporativo : VARCHAR(150)
  * contrasena_hash : VARCHAR(255)
  * rol : VARCHAR(30)
  * activo : BOOLEAN
}

entity "CLIENTE" as cliente {
  * id_cliente : VARCHAR(36) [PK]
  --
  * id_usuario_responsable : VARCHAR(36) [FK]
  id_centro_coste : VARCHAR(36) [FK]
  * nombre_comercial : VARCHAR(150)
  * razon_social : VARCHAR(150)
  * nif_cif : VARCHAR(50)
  * domicilio_fiscal : TEXT
  * pais : VARCHAR(100)
  * moneda_trabajo : VARCHAR(3)
  * fecha_inicio : DATE
  fecha_baja : DATE
  * es_favorito : BOOLEAN
  * estado_suscripcion : VARCHAR(30)
  facturacion_anual_verificada : DECIMAL(12,2)
}

entity "CONTACTO" as contacto {
  * id_contacto : VARCHAR(36) [PK]
  --
  * nombre : VARCHAR(100)
  * email : VARCHAR(150)
  * activo : BOOLEAN
  * es_contacto_facturacion : BOOLEAN
}

entity "CLIENTE_CONTACTO" as cliente_contacto {
  * id_cliente : VARCHAR(36) [PK, FK]
  * id_contacto : VARCHAR(36) [PK, FK]
}

entity "PLAN_TARIFA" as plan_tarifa {
  * id_plan : VARCHAR(36) [PK]
  --
  * nombre_plan : VARCHAR(100)
  * importe_base : DECIMAL(10,2)
  * rango_facturacion_min : DECIMAL(12,2)
  * rango_facturacion_max : DECIMAL(12,2)
  * fecha_vigor : DATE
}

entity "SUSCRIPCION" as suscripcion {
  * id_suscripcion : VARCHAR(36) [PK]
  --
  * id_cliente : VARCHAR(36) [FK]
  * id_plan : VARCHAR(36) [FK]
  * fecha_inicio : DATE
  fecha_fin_prevista : DATE
  * importe_mensual : DECIMAL(10,2)
  fecha_pausa_inicio : DATE
  fecha_pausa_reactivacion : DATE
  motivo_pausa : TEXT
}

entity "EXCEPCION_COMERCIAL" as excepcion_comercial {
  * id_excepcion : VARCHAR(36) [PK]
  --
  * id_cliente : VARCHAR(36) [FK]
  * tipo : VARCHAR(40)
  * fecha_inicio : DATE
  observacion : TEXT
}

entity "FACTURA" as factura {
  * id_factura : VARCHAR(36) [PK]
  --
  * id_cliente : VARCHAR(36) [FK]
  id_factura_rectificada : VARCHAR(36) [FK]
  * numero_factura : VARCHAR(50)
  * serie : VARCHAR(20)
  * fecha_emision : DATE
  * fecha_vencimiento : DATE
  * tipo : VARCHAR(20)
  * estado : VARCHAR(30)
  * base_imponible : DECIMAL(12,2)
  * total_impuestos : DECIMAL(12,2)
  * total_factura : DECIMAL(12,2)
  * importe_pendiente : DECIMAL(12,2)
  * retenida_para_revision : BOOLEAN
  * es_migrada : BOOLEAN
  * documento_id : VARCHAR(255)
  * hash_documento : VARCHAR(64)
}

entity "IMPUESTO" as impuesto {
  * id_impuesto : VARCHAR(36) [PK]
  --
  * nombre : VARCHAR(50)
  * porcentaje : DECIMAL(5,2)
  * activo : BOOLEAN
}

entity "LINEA_FACTURA" as linea_factura {
  * id_linea : VARCHAR(36) [PK]
  --
  * id_factura : VARCHAR(36) [FK]
  * id_impuesto : VARCHAR(36) [FK]
  * concepto : VARCHAR(255)
  * cantidad : INT
  * precio_unitario : DECIMAL(10,2)
  * porcentaje_descuento : DECIMAL(5,2)
  * subtotal : DECIMAL(12,2)
}

entity "COBRO" as cobro {
  * id_cobro : VARCHAR(36) [PK]
  --
  referencia_pago : VARCHAR(100)
  * pasarela_pago : VARCHAR(30)
  * fecha_cobro : TIMESTAMP
  * importe : DECIMAL(12,2)
  * moneda : VARCHAR(3)
  concepto : TEXT
}

entity "CONCILIACION" as conciliacion {
  * id_conciliacion : VARCHAR(36) [PK]
  --
  * id_factura : VARCHAR(36) [FK]
  * id_cobro : VARCHAR(36) [FK]
  id_usuario_reversion : VARCHAR(36) [FK]
  * fecha_conciliacion : TIMESTAMP
  * importe_conciliado : DECIMAL(12,2)
  * es_automatica : BOOLEAN
  motivo_reversion : TEXT
}

entity "SOLICITUD_APROBACION" as solicitud_aprobacion {
  * id_solicitud : VARCHAR(36) [PK]
  --
  * id_usuario_solicitante : VARCHAR(36) [FK]
  id_usuario_aprobador : VARCHAR(36) [FK]
  id_factura : VARCHAR(36) [FK]
  id_cliente : VARCHAR(36) [FK]
  * tipo_solicitud : VARCHAR(40)
  * motivo : TEXT
  porcentaje_descuento : DECIMAL(5,2)
  importe_propuesto : DECIMAL(12,2)
  * estado : VARCHAR(20)
  * fecha_solicitud : TIMESTAMP
  fecha_resolucion : TIMESTAMP
}

entity "INCIDENCIA" as incidencia {
  * id_incidencia : VARCHAR(36) [PK]
  --
  id_factura : VARCHAR(36) [FK]
  id_usuario_asignado : VARCHAR(36) [FK]
  * titulo : VARCHAR(200)
  * descripcion : TEXT
  * estado : VARCHAR(20)
  * prioridad : VARCHAR(20)
  * fecha_creacion : TIMESTAMP
}

entity "COMENTARIO_INTERNO" as comentario_interno {
  * id_comentario : VARCHAR(36) [PK]
  --
  * id_incidencia : VARCHAR(36) [FK]
  * id_usuario_autor : VARCHAR(36) [FK]
  * contenido : TEXT
  * fecha : TIMESTAMP
}

entity "MENCION_COMENTARIO" as mecion_comentario {
  * id_comentario : VARCHAR(36) [PK, FK]
  * id_usuario_mencionado : VARCHAR(36) [PK, FK]
}

entity "PLANTILLA_COMUNICACION" as plantilla_comunicacion {
  * id_plantilla : VARCHAR(36) [PK]
  --
  * nombre : VARCHAR(100)
  * asunto : VARCHAR(200)
  * cuerpo_html : TEXT
  * tipo_evento : VARCHAR(50)
  * idioma : VARCHAR(5)
}

entity "REGISTRO_ENVIO" as registro_envio {
  * id_registro : VARCHAR(36) [PK]
  --
  * id_factura : VARCHAR(36) [FK]
  * id_plantilla : VARCHAR(36) [FK]
  * canal : VARCHAR(20)
  * destinatario : VARCHAR(150)
  * fecha_envio : TIMESTAMP
  * exitoso : BOOLEAN
  motivo_error : TEXT
}

entity "REGLA_ALERTA" as regla_alerta {
  * id_regla : VARCHAR(36) [PK]
  --
  * nombre : VARCHAR(100)
  dias_vencimiento_max : INT
  importe_pendiente_max : DECIMAL(12,2)
  * activa : BOOLEAN
}

entity "NOTIFICACION" as notificacion {
  * id_notificacion : VARCHAR(36) [PK]
  --
  * id_usuario : VARCHAR(36) [FK]
  id_regla : VARCHAR(36) [FK]
  * titulo : VARCHAR(150)
  * mensaje : TEXT
  * fecha : TIMESTAMP
  * leida : BOOLEAN
  * resuelta : BOOLEAN
  * canal : VARCHAR(20)
}

entity "TAREA" as tarea {
  * id_tarea : VARCHAR(36) [PK]
  --
  * id_cliente : VARCHAR(36) [FK]
  * titulo : VARCHAR(200)
  fecha_vencimiento : DATE
  * completada : BOOLEAN
}

entity "ETIQUETA" as etiqueta {
  * id_etiqueta : VARCHAR(36) [PK]
  --
  * nombre : VARCHAR(50)
  color : VARCHAR(7)
}

entity "CLIENTE_ETIQUETA" as cliente_etiqueta {
  * id_cliente : VARCHAR(36) [PK, FK]
  * id_etiqueta : VARCHAR(36) [PK, FK]
}

entity "CENTRO_COSTE" as centro_coste {
  * id_centro_coste : VARCHAR(36) [PK]
  --
  * codigo : VARCHAR(20)
  * nombre : VARCHAR(100)
}

entity "OBJETIVO_FACTURACION" as objetivo_facturacion {
  * id_objetivo : VARCHAR(36) [PK]
  --
  * id_usuario_modificador : VARCHAR(36) [FK]
  * periodo : VARCHAR(20)
  * importe_objetivo : DECIMAL(12,2)
  * fecha_modificacion : TIMESTAMP
}

entity "REGISTRO_AUDITORIA" as registro_auditoria {
  * id_auditoria : VARCHAR(36) [PK]
  --
  * id_usuario : VARCHAR(36) [FK]
  * accion : VARCHAR(100)
  * entidad : VARCHAR(50)
  * id_entidad : VARCHAR(36)
  * fecha : TIMESTAMP
  detalles : TEXT
}

entity "EVENTO_LINEA_TEMPORAL" as evento_linea_temporal {
  * id_evento : VARCHAR(36) [PK]
  --
  * id_cliente : VARCHAR(36) [FK]
  * tipo_evento : VARCHAR(50)
  * descripcion : TEXT
  * fecha : TIMESTAMP
}

usuario ||--o{ cliente : "gestiona (responsable)"
cliente ||--o{ cliente_contacto : "tiene"
contacto ||--o{ cliente_contacto : "pertenece a"
