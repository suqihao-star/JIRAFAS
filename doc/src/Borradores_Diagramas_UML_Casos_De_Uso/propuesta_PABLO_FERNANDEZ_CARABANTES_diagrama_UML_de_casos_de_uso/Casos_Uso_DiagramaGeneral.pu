@startuml
skinparam actorStyle awesome
left to right direction
title Diagrama general de casos de uso
actor "Usuario operativo" as UO
actor "Administrador" as ADMIN
actor "Superadministrador" as SADMIN
UO <|-- ADMIN
ADMIN <|-- SADMIN
rectangle "Sistema de facturación de Turbine" {
rectangle "A. Clientes y contactos" {
    usecase "CU-01 Gestionar cliente y contactos" as CU01
    usecase "CU-02 Detectar cliente duplicado" as CU02
    usecase "CU-03 Importar datos por CSV" as CU03
    usecase "CU-04 Gestionar tareas del cliente" as CU04
  }
rectangle "B. Suscripciones, tarifas y descuentos" {
    usecase "CU-05 Gestionar baja y pausa de suscripción" as CU05
    usecase "CU-06 Revisar y aprobar rango de tarifa anual" as CU06
    usecase "CU-07 Solicitar descuento" as CU07
    usecase "CU-08 Aprobar descuento" as CU08
    usecase "CU-09 Escalar aprobación al Superadministrador" as CU09
  }
rectangle "C. Facturación" {
    usecase "CU-10 Gestionar borrador de factura" as CU10
    usecase "CU-11 Generar facturas recurrentes" as CU11
    usecase "CU-12 Emitir factura" as CU12
    usecase "CU-13 Aprobar factura retenida" as CU13
    usecase "CU-14 Rectificar, anular o declarar incobrable una factura" as CU14
    usecase "CU-15 Buscar y consultar facturas y clientes" as CU15
  }
rectangle "D. Cobros y comunicaciones" {
    usecase "CU-16 Registrar movimiento de cobro" as CU16
    usecase "CU-17 Conciliar pagos" as CU17
    usecase "CU-18 Enviar comunicación al cliente" as CU18
    usecase "CU-19 Gestionar rebote de correo" as CU19
    usecase "CU-20 Ejecutar flujo de recordatorios e impago" as CU20
    usecase "CU-21 Suspender recordatorios de una factura" as CU21
    usecase "CU-22 Gestionar plantillas de comunicación" as CU22
  }
rectangle "E. Seguimiento, consulta e informes" {
    usecase "CU-23 Gestionar notificaciones y canales" as CU23
    usecase "CU-24 Configurar alertas" as CU24
    usecase "CU-25 Gestionar incidencias y comentarios" as CU25
    usecase "CU-26 Generar, exportar y conservar informes" as CU26
    usecase "CU-27 Consultar dashboard financiero" as CU27
    usecase "CU-28 Gestionar objetivos y centros de coste" as CU28
    usecase "CU-29 Consultar pantalla de trabajo diario" as CU29
  }
rectangle "F. Administración, seguridad y sistema" {
    usecase "CU-30 Iniciar sesión y recuperar contraseña" as CU30
    usecase "CU-31 Gestionar usuarios, roles y asignación de clientes" as CU31
    usecase "CU-32 Ejecutar acción masiva" as CU32
    usecase "CU-33 Consultar monitorización y métricas" as CU33
    usecase "CU-34 Consultar registro de auditoría" as CU34
    usecase "CU-35 Configurar facturación y tarifas" as CU35
    usecase "CU-36 Configurar recordatorios y funciones inteligentes" as CU36
    usecase "CU-37 Consultar datos y operar por API" as CU37
  }
}
actor "Planificador del sistema" as PS
actor "Sistema de pagos\n(Stripe/Revolut)" as SP
actor "Proveedor de correo" as PC
actor "Sistema externo" as EXT
UO -- CU01
UO -- CU03
UO -- CU04
UO -- CU05
PS -- CU05
ADMIN -- CU06
UO -- CU07
ADMIN -- CU08
SADMIN -- CU09
UO -- CU10
PS -- CU11
UO -- CU12
ADMIN -- CU13
ADMIN -- CU14
UO -- CU15
SP -- CU16
PS -- CU16
UO -- CU17
PC -- CU18
UO -- CU19
PC -- CU19
PS -- CU20
UO -- CU21
ADMIN -- CU22
UO -- CU23
PS -- CU23
ADMIN -- CU24
UO -- CU25
UO -- CU26
ADMIN -- CU27
ADMIN -- CU28
UO -- CU29
UO -- CU30
ADMIN -- CU31
ADMIN -- CU32
ADMIN -- CU33
PS -- CU33
SADMIN -- CU34
SADMIN -- CU35
SADMIN -- CU36
EXT -- CU37
CU01 ..> CU02 : <<include>>
CU03 ..> CU02 : <<include>>
CU11 ..> CU12 : <<include>>
CU12 ..> CU18 : <<include>>
CU16 ..> CU17 : <<include>>
CU20 ..> CU18 : <<include>>
CU19 ..> CU25 : <<include>>
CU09 ..> CU08 : <<extend>>
note on link
  El descuento supera el umbral configurable
end note
CU13 ..> CU12 : <<extend>>
note on link
  La factura tiene un cambio sensible (importe manual,
  descuento extraordinario, vencimiento atípico o
  puntual de importe alto)
end note
CU19 ..> CU18 : <<extend>>
note on link
  El correo rebota
end note
CU21 ..> CU20 : <<extend>>
note on link
  Una factura concreta está en disputa o
  seguimiento pausado
end note
legend bottom
Herencia: el Administrador puede hacer todo lo del Usuario Operativo y el Superadministrador todo lo del Administrador. 
Cada caso se asocia solo al rol más bajo que puede hacerlo. Los roles superiores lo heredan.
endlegend
@enduml