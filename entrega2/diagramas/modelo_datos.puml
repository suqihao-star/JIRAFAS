}
entity "NOTIFICACION" as notificacion {
  * id_notificacion : NUMBER(10) <<PK>>
  --
  * id_usuario : NUMBER(10) <<FK>>
    id_regla : NUMBER(10) <<FK>>
    id_comentario : NUMBER(10) <<FK>>
