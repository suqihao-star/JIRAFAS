    motivo_reversion : VARCHAR2(300 CHAR)
}
entity "PLANTILLA_COMUNICACION" as plantilla_comunicacion {
  * id_plantilla : NUMBER(10) <<PK>>
  --
  * tipo : VARCHAR2(25 CHAR)
  * idioma : VARCHAR2(5 CHAR)
