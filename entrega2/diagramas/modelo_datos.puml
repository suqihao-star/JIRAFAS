  * tipo : VARCHAR2(25 CHAR)
  * canal : VARCHAR2(20 CHAR)
  * idioma : VARCHAR2(5 CHAR)
  * estado : VARCHAR2(15 CHAR)
    fecha_envio : TIMESTAMP
  * numero_intento : NUMBER(10)
    correo_destinatario : VARCHAR2(150 CHAR)
}
entity "SUSPENSION_RECORDATORIOS" as suspension_recordatorios {
  * id_suspension : NUMBER(10) <<PK>>
  --
  * id_factura : NUMBER(10) <<FK>>
  * motivo : VARCHAR2(300 CHAR)
  * fecha_revision : DATE
  * activa : NUMBER(1)
}

entity "CENTRO_COSTE" as centro_coste {
  * id_centro_coste : NUMBER(10) <<PK>>
