@startuml diagrama_clases_bloque_E
title Diagrama de clases Bloque E - Seguimiento, consulta e informes
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "Bloque E - Seguimiento, consulta e informes" {
  class Notificacion {
    - categoria : String
    - mensaje : String
    - elementoRelacionado : String
    - fecha : FechaHora
    - requiereAccion : Boolean
    - leida : Boolean
    - resuelta : Boolean
    + marcarLeida() : void
    + marcarResuelta() : void
  }

  class ReglaAlerta {
    - tipo : TipoAlerta
    - umbral : Decimal
    - activa : Boolean
    + evaluar() : Boolean
  }

  class Incidencia {
    - tipo : TipoIncidencia
    - descripcion : String
    - estado : EstadoIncidencia
    - prioridad : Prioridad
    - fechaCreacion : FechaHora
    - adjuntos : List<String>
    + resolver(comentario : String) : void
  }
  class Comentario {
    - texto : String
    - fecha : FechaHora
  }
  note bottom of Comentario
    Siempre interno: nunca se envía
    al cliente (BR-20)
  end note
  class Informe {
    - filtros : String
    - formato : FormatoInforme
    - estado : EstadoInforme
    - fechaGeneracion : FechaHora
    - fechaCaducidad : FechaHora
    + generar() : void
    + exportar() : String
    + regenerar() : void
  }

  class ObjetivoFacturacion {
    - periodo : String
    - valor : Decimal
    + modificar(valor : Decimal) : void
  }

  class CentroCoste {
    - nombre : String
    - tipo : TipoCentroCoste
    - activo : Boolean
  }

  enum TipoAlerta {
    DIAS_VENCIDA
    IMPORTE_PENDIENTE
  }
  enum TipoIncidencia {
    ENTREGA
    COBRO
    FACTURACION
    OTRA
  }
  enum EstadoIncidencia {
    ABIERTA
    EN_CURSO
    RESUELTA
    CERRADA
  }
  enum Prioridad {
    BAJA
    MEDIA
    ALTA
  }
  enum FormatoInforme {
    CSV
    PDF
  }
  enum EstadoInforme {
    PENDIENTE
    PROCESANDO
    COMPLETADO
    COMPLETADO_CON_ERRORES
  }
  enum TipoCentroCoste {
    CENTRO_COSTE
    PROYECTO
  }
}

abstract class Usuario
class Cliente 
class Factura 
class Administrador 

Usuario "1" -- "0..*" Notificacion : recibe >
ReglaAlerta "0..1" -- "0..*" Notificacion : genera >
Cliente "1" -- "0..*" Incidencia
Factura "0..1" -- "0..*" Incidencia
Incidencia "0..*" --> "1" Usuario : responsable
Incidencia "1" *-- "0..*" Comentario
Comentario "0..*" --> "1" Usuario : autor
Comentario "0..*" --> "0..*" Usuario : menciona
Comentario "0..1" -- "0..*" Notificacion : genera >
Usuario "1" -- "0..*" Informe : solicita >
Factura "0..*" --> "0..1" CentroCoste
Cliente "0..*" --> "0..1" CentroCoste
Administrador "1" -- "0..*" ObjetivoFacturacion : gestiona >
ReglaAlerta ..> TipoAlerta
Incidencia ..> TipoIncidencia
Incidencia ..> EstadoIncidencia
Incidencia ..> Prioridad
Informe ..> FormatoInforme
Informe ..> EstadoInforme
CentroCoste ..> TipoCentroCoste
@enduml