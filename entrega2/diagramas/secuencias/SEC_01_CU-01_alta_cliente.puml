@startuml SEC_01_CU-01_alta_cliente
skinparam sequenceMessageAlign center
skinparam maxMessageSize 170
skinparam ParticipantPadding 12
hide footbox
autonumber
title CU-01 - Alta de cliente y contactos

actor "Usuario operativo" as UO
control ":Sistema" as SYS
participant "cfg : ConfiguracionSistema" as CFG
participant "ctExistente : Contacto" as CTE

UO -> SYS : nuevoCliente()
activate SYS
SYS -> SYS : comprobarPermiso(u, ALTA_CLIENTE)
break [PRE-1: el usuario no tiene permiso de gestión de clientes]
  SYS --> UO : acceso denegado
end
SYS -> CFG ++ : getVencimientoGeneralDias()
return vencimiento por defecto
SYS --> UO : formulario con país, moneda, vencimiento\ny tarifa autocompletados (FR-30)
deactivate SYS

UO -> SYS : guardarCliente(datosFiscales, fichaComercial,\ncontactos, excepcion)
activate SYS
SYS -> SYS : comprobarPermiso(u, ALTA_CLIENTE)
break [el permiso ya no está vigente al guardar]
  SYS --> UO : acceso denegado
end
SYS -> SYS : validarFormato(datos, responsableInterno)
note right of SYS : el identificador fiscal puede\nfaltar (FA-5)

alt [FE-2: campos obligatorios vacíos, formato inválido\no responsable interno no válido]
  SYS --> UO : señala los campos a corregir
else [formato correcto]
  create participant "c : Cliente" as C
  SYS -->> C : <<create>> Cliente(datosFiscales, condicionesPago,\ndocumentoFirmado, vencimientoPactadoDias, fechaInicio)
  note right of C : objeto candidato, aún no registrado:\nsolo se persiste al llamar a darDeAlta().\nLa ficha comercial se reparte: condiciones\nde pago y documento en Cliente; plan y\ntarifa en Suscripcion
  SYS -> C ++ : comprobarDuplicado()
  return duplicado : Boolean

  note right of C : por identificador fiscal (FR-27); si aún\nfalta (FA-5) no hay coincidencia posible\ny devuelve false
  alt [FE-1: posible cliente duplicado]
    SYS --> UO : aviso de duplicado: ofrece abrir la ficha\nexistente (sin fusionar) o corregir la actual
    SYS -> SYS : descartar(c)
    note right of SYS : el candidato no se registra; el formulario\nconserva los datos para corregirlos y\nvolver a guardarCliente()
  else [sin duplicado]
    opt [FA-5: falta el identificador fiscal]
      SYS -> C : setDatosFiscalesIncompletos(true)
      SYS --> UO : aviso: falta el identificador fiscal;\nno se podrá facturar hasta completarlo
      note right of C : CU-12 FE-1 bloqueará la emisión\nmientras falte
    end
    create participant "s : Suscripcion" as S
    SYS -->> S : <<create>> Suscripcion(plan, precioVigente = tarifa acordada,\nfechaInicio)
    note right of S : la ficha comercial (plan y tarifa)\nse guarda en la Suscripcion del cliente\n(composición Cliente ◆ Suscripcion)
    opt [alta a mitad de mes]
      SYS -> S ++ : calcularProrrateo(periodo)
      return importe prorrateado
      SYS --> UO : muestra el prorrateo de la primera factura (FR-11)
      UO -> SYS : confirmar()
    end

    SYS -> C : cambiarResponsable(responsable)
    SYS -> C : addSuscripcion(s)
    SYS -> C ++ : darDeAlta()
    note right of C
      estado = ACTIVO, o PENDIENTE_ACTIVACION
      si la fecha de inicio es futura (FA-4):
      no se generan facturas ni recordatorios
    end note
    return ok

    loop [para cada contacto introducido]
      SYS -> SYS : buscarContacto(correo)
      alt [el contacto ya existe (puede pertenecer a varios clientes, FR-04)]
        SYS -> CTE ++ : getActivo()
        return activo : Boolean
        opt [el contacto existente está inactivo]
          SYS --> UO : aviso: contacto inactivo; se vincula,\npero no recibirá comunicaciones
        end
        SYS -> SYS : contacto = ctExistente
      else [contacto nuevo]
        create participant "ct : Contacto" as CT
        SYS -->> CT : <<create>> Contacto(nombre, correo, idioma)
        SYS -> SYS : contacto = ct
      end
      create participant "cc : ClienteContacto" as CC
      SYS -->> CC : <<create>> ClienteContacto(c, contacto, tipo)
      note right of CC : tipo: CONTRATACION,\nFACTURACION, IMPAGOS
    end

    opt [FA-4: excepción comercial explícita]
      create participant "ex : ExcepcionComercial" as EX
      SYS -->> EX : <<create>> ExcepcionComercial(tipo, fechaInicioFutura,\naprobada = false si tiene efecto económico)
      SYS -> C : addExcepcion(ex)
      note right of EX : composición Cliente ◆ ExcepcionComercial
      opt [la excepción tiene efecto económico\n(PRIMER_MES_GRATIS o SIN_PRORRATEO)]
        ref over SYS, EX : CU-07 Solicitar descuento: la SolicitudDescuento creada\nqueda enlazada con ex («se aprueba mediante»);\nno se aplica hasta aprobarse en CU-08
      end
    end

    create participant "ev : EventoAuditoria" as EV
    SYS -->> EV : <<create>> EventoAuditoria("ALTA", "Cliente", c.id)
    note right of EV : alimenta la línea\ntemporal del cliente
    SYS --> UO : muestra el cliente creado
  end
end
deactivate SYS
@enduml
