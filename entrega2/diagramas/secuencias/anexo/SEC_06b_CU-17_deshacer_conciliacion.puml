@startuml SEC_06b_CU-17_deshacer_conciliacion
skinparam sequenceMessageAlign center
skinparam maxMessageSize 170
skinparam ParticipantPadding 12
hide footbox
autonumber
title CU-17 (FA-3) - Deshacer una conciliación

actor "Usuario operativo" as UO
control ":Sistema" as SYS
participant "con : Conciliacion" as CON
participant "f : Factura" as F
participant "m : MovimientoCobro" as M

UO -> SYS : revertirConciliacion(idConciliacion, motivo)
activate SYS
SYS -> SYS : buscarConciliacion(idConciliacion)
note right of SYS : con puede ser MANUAL o\nAUTOMATICA (regla de CU-16)
SYS -> SYS : comprobarAsignacion(u, cliente de con)

break sin permiso sobre el cliente o sin motivo
  SYS --> UO : reversión denegada; sin cambios
end

critical reversión y recálculo atómicos
  SYS -> CON ++ : getRevertida()
  return revertida : Boolean
  alt ya revertida (p. ej. por otro usuario)
    SYS --> UO : ya estaba revertida; sin cambios
  else conciliación vigente
    SYS -> CON ++ : revertir(motivo)
    note right of CON
      revertida = true, motivoReversion.
      NO se borra: queda quién (o qué regla)
      la hizo y quién la revirtió, cuándo y
      por qué (FR-22).
    end note
    return ok
    SYS -> CON : setRevertidaPor(u)
    SYS -> F ++ : getSaldoPendiente()
    note right of F : /saldoPendiente es derivado: al quedar la\nconciliación revertida vuelve a incluir su importe
    return saldo recalculado
    SYS -> F ++ : getEstado()
    return estado actual
    opt estado de cobro (PAGADA o PARCIALMENTE_CONCILIADA)
      SYS -> F ++ : getFechaVencimiento()
      return fechaVencimiento
      SYS -> F ++ : getComunicaciones()
      return historial de envíos
      SYS -> F : setEstado(nuevoEstado)
      note right of F
        PARCIALMENTE_CONCILIADA si aún tiene cobros vigentes;
        si no: VENCIDA si fechaVencimiento < hoy;
        si no, ENVIADA si consta una Comunicacion FACTURA
        enviada, y EMITIDA en otro caso.
        ANULADA, RECTIFICADA, INCOBRABLE o CANCELADA
        no se tocan: la reversión no reabre la factura.
      end note
    end
    SYS -> M ++ : getConciliaciones()
    return conciliaciones aún vigentes
    SYS -> M : setEstado(CONCILIADO si todo su importe sigue asignado;\nPARCIAL si queda una parte; PENDIENTE_CONCILIACION si nada)
    note right of M : no pasa entero a PENDIENTE si conserva\notras asociaciones válidas
    create participant "ev : EventoAuditoria" as EV
    SYS -->> EV : <<create>> EventoAuditoria("REVERTIR_CONCILIACION",\n"Conciliacion", idConciliacion)
    SYS --> UO : reversión registrada sin borrar el histórico
  end
end
deactivate SYS
@enduml
