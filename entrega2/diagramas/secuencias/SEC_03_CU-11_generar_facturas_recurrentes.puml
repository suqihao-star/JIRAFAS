@startuml SEC_03_CU-11_generar_facturas_recurrentes
skinparam sequenceMessageAlign center
skinparam maxMessageSize 170
skinparam ParticipantPadding 12
hide footbox
autonumber
title CU-11 - Generar facturas recurrentes

actor "Planificador del sistema" as PL
control ":Sistema" as SYS
participant "s : Suscripcion" as S
participant "c : Cliente" as C
participant "ex : ExcepcionComercial" as EX
participant "cfg : ConfiguracionSistema" as CFG
participant "ej : EjecucionTarea" as EJ
participant "f : Factura" as F

PL -> SYS : generarRecurrentes(periodo)
activate SYS
SYS -> SYS : ej = obtenerEjecucion(GENERACION_RECURRENTE, periodo)
note right of SYS : devuelve la ejecución INTERRUMPIDA del periodo\no crea una nueva (EN_CURSO) si no la hay
opt [FA-3: ej estaba INTERRUMPIDA]
  SYS -> EJ ++ : reanudar()
  note right of EJ : EjecucionTarea —genera— Factura:\nse sabe qué mensualidades ya existen
  return
end

loop [para cada suscripción registrada]
  SYS -> S ++ : esFacturable(periodo)
  return facturable : Boolean

  alt [FA-1: no facturable (pausada, cancelada\no pendiente de activación)]
    SYS -> EJ : setResumen(resumen + "omitida: motivo")

  else [facturable]
    SYS -> C ++ : getExcepciones()
    return excepciones : List<ExcepcionComercial>
    opt [FA-4: existe excepción comercial]
      SYS -> EX ++ : getAprobada()
      return aprobada : Boolean
    end

    alt [FA-4: excepción aprobada y periodo exento\n(primer mes gratuito / mes inicial sin prorrateo)]
      SYS -> EJ : setResumen(resumen + "periodo exento")

    else [periodo no exento]
      opt [FA-4: excepción con efecto económico aún pendiente]
        create participant "n : Notificacion" as N
        SYS -->> N : <<create>> Notificacion("EXCEPCION_PENDIENTE", mensaje)
        note right of N : al responsable; la excepción\nNO se aplica
      end

      critical [obligación única por suscripción y periodo:\nobtener y preparar f de forma atómica]
        SYS -> SYS : f = obtenerFacturaDelPeriodo(s, periodo, ej)
        note right of SYS
          busca la factura del periodo DENTRO de la
          sección crítica. Si no existe, crea una
          RECURRENTE en BORRADOR ligada a ej
          (EjecucionTarea —genera— Factura) y sin
          creadaPor, porque la genera el Planificador.
        end note
        opt [f en BORRADOR y todavía sin líneas]
          SYS -> S ++ : getPrecioVigente()
          return tarifa aprobada
          SYS -> C ++ : getVencimientoPactadoDias()
          return días pactados (si existen)
          SYS -> CFG ++ : getVencimientoGeneralDias()
          return vencimiento general
          SYS -> F : setFechaVencimiento(fechaEmisionPrevista + días\npactados o, si no hay, generales)
          SYS -> SYS : buscarDescuentoVigente(c, periodo)
          opt [hay un descuento en estado APROBADA y vigente (CU-08);\nuno APROBADA_CONDICIONADA no se aplica todavía]
            SYS -> F : setDescuentoAplicado(solicitudDescuento)
            note right of F : asociación Factura → SolicitudDescuento\n«descuentoAplicado» del modelo
          end
          opt [FA-2: primera mensualidad a mitad de mes]
            SYS -> S ++ : calcularProrrateo(periodo)
            return importe prorrateado
          end
          create participant "lf : LineaFactura" as LF
          SYS -->> LF : <<create>> LineaFactura(concepto = plan, cantidad,\nprecioUnitario = precio vigente o prorrateado,\ndescuento = el del descuento aplicado, si lo hay)
          SYS -> LF : setImpuesto(impuesto configurado)
          SYS -> F : addLinea(lf)
        end
        note right of F : la preparación es atómica: un borrador\nrecuperado (FA-3) tiene todas sus líneas\no ninguna; nunca se duplican
      end

      alt [FA-3: f ya tiene emisión definitiva\n(EMITIDA, ENVIADA, VENCIDA, PAGADA...)]
        SYS -> EJ : setResumen(resumen + "ya emitida")

      else [f no tiene emisión definitiva (nueva o pendiente)]
        SYS -> F ++ : calcularTotales()
        return

        alt [FE-1: faltan datos fiscales o hay una condición económica\nsin aprobar (distinta de las excepciones de FA-4, que\nsimplemente no se aplican)]
          create participant "i : Incidencia" as I
          SYS -->> I : <<create>> Incidencia(tipo = FACTURACION, cliente = c, factura = f,\nresponsable = responsable interno de c)
          note right of I : para que una persona autorizada\nla resuelva; el lote continúa
          SYS -> EJ : setResumen(resumen + "pendiente: cliente y causa")
        else [datos y condiciones completos]
          ref over SYS, F : CU-12 Emitir factura (FA-2: emisión automática de f,\nsin vista previa); devuelve EMITIDA, RETENIDA\no ERROR(causa, idError)
          alt [CU-12 devuelve ERROR (FE-2)]
            SYS -> EJ : setErrores(errores + idError + causa)
            note right of EJ : el reintento reutiliza f\ny no duplica
          else [CU-12 devuelve RETENIDA (CU-13)]
            SYS -> EJ : setResumen(resumen + "retenida")
          else [CU-12 devuelve EMITIDA]
            SYS -> EJ : setResumen(resumen + "emitida")
          end
        end
      end
    end
  end
end

SYS -> EJ : setFin(ahora)
SYS -> EJ : setEstado(COMPLETADA o COMPLETADA_CON_ERRORES)
note right of EJ : resumen disponible en la\nmonitorización (CU-33, FR-48)
SYS --> PL : resumen de emitidas, pendientes y errores
deactivate SYS
@enduml
