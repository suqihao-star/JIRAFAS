@startuml arquitectura_dominio
title Relaciones entre los módulos de negocio (bloques A-F)
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam nodesep 45
skinparam ranksep 55
top to bottom direction

package "Módulos de negocio (núcleo de dominio)" as DOMINIO {
  [Bloque A\nClientes y contactos] as MA
  [Bloque B\nSuscripciones y descuentos] as MB
  [Bloque C\nFacturación] as MC
  [Bloque D\nCobros y comunicaciones] as MD
  [Bloque E\nSeguimiento e informes] as ME
  [Bloque F\nAdministración y sistema] as MF

  MA -[hidden]right- MB
  MB -[hidden]right- MC
  MF -[hidden]right- MD
  MD -[hidden]right- ME
  MA -[hidden]down- MF
  MB -[hidden]down- MD
  MC -[hidden]down- ME
}

MA --> MB : Cliente 1 — 0..* Suscripcion
MB --> MC : Suscripcion 0..1 — 0..* Factura
MA --> MC : Cliente 1 — 0..* Factura
MC --> MD : Factura 1 — 0..* Conciliacion /\n0..* Comunicacion
MD --> ME : rebote crea Incidencia /\nNotificacion
MC --> ME : CentroCoste, Informes
MF ..> MC : SerieFacturacion, Impuesto
MF ..> MB : RangoTarifa, umbral descuento
MF ..> MD : cadencia recordatorios
MF --> MA : SolicitudExterna\n(pendiente revisión)
@enduml
