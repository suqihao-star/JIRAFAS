@startuml diagrama_arquitectura_turbine_refinado
title Arquitectura del sistema de facturación de TurbineH
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam nodesep 45
skinparam ranksep 55
top to bottom direction

actor "Usuario operativo" as UO
actor "Administrador" as ADM
actor "Superadministrador" as SADM
UO <|-- ADM
ADM <|-- SADM

package "Capa de presentación" {
  [Aplicación web responsive\n(escritorio, tablet, móvil - NFR-04)\nTrabajo diario, dashboard,\nbuscador e informes] as WEB
}

package "Capa de aplicación (servidor)" {
  [API REST documentada y autenticada\n(misma lógica de negocio que la web - BR-07)] as API
  [Seguridad transversal\nSesiones, 2FA opcional,\nRBAC en servidor (NFR-07/08/09)] as SEG

  package "Módulos de negocio (núcleo de dominio)" as DOMINIO {
    [Bloque A\nClientes y contactos\n(Cliente, Contacto, Tarea,\nImportacionCSV)] as MA
    [Bloque B\nSuscripciones y descuentos\n(Suscripcion, RevisionTarifaAnual,\nSolicitudDescuento)] as MB
    [Bloque C\nFacturación\n(Factura, FacturaRectificativa,\nAprobacionFactura, OperacionExcepcional)] as MC
    [Bloque D\nCobros y comunicaciones\n(MovimientoCobro, Conciliacion,\nComunicacion)] as MD
    [Bloque E\nSeguimiento e informes\n(Notificacion, Incidencia, Informe,\nObjetivoFacturacion, CentroCoste)] as ME
    [Bloque F\nAdministración y sistema\n(Usuario, UsuarioOperativo, AccionMasiva,\nConfiguracionSistema, SerieFacturacion,\nImpuesto, RangoTarifa, SolicitudExterna)] as MF

    ' Rejilla 2x3: A-B-C / F-D-E
    MA -[hidden]right- MB
    MB -[hidden]right- MC
    MF -[hidden]right- MD
    MD -[hidden]right- ME
    MA -[hidden]down- MF
    MB -[hidden]down- MD
    MC -[hidden]down- ME
  }

  [Auditoría\nEventoAuditoria (solo lectura - NFR-09)] as AUD
  [Monitorización y métricas\nEjecucionTarea, colas y errores (CU-33)] as MON
}

package "Procesamiento asíncrono" as ASYNC {
  package "Planificador del sistema (Cron)" as PLAN {
    [Generación recurrente\n(día 1, idempotente - NFR-15)] as J1
    [Recordatorios e impago\n(diario - CU-20)] as J2
    [Consulta periódica\nde pagos (CU-16)] as J3
    [Resumen diario\nde notificaciones (CU-23)] as J4
    [Copia de seguridad\nautomática (NFR-14)] as J5
  }
  [Workers en segundo plano\nInformes pesados (CU-26) y\nreintentos de envío (NFR-12)] as WRK
}

package "Capa de integración y servicios documentales" as INTEGRACION {
  interface "SistemaPagos" as IPAGOS
  interface "CanalEnvio" as ICANAL
  [Adaptador Stripe / Revolut\n/ otra fuente] as APAG
  [Adaptador correo electrónico] as AMAIL
  [Adaptador WhatsApp\n(simulado, con consentimiento)] as AWA
  [Motor documental\nGenerador PDF legal / Parser CSV] as DOCS
  [Adaptador IA opcional\n(Brain)] as AIA
}

package "Persistencia" {
  database "Base de datos relacional\nDecimal exacto (NFR-06),\nsecuencias atómicas, entidades A-F\ny PDF de facturas (FR-12)" as DB
  folder "Almacén de documentos\nInformes y adjuntos\n(enlaces temporales 1h - NFR-17, A-03)" as FS
  folder "Copias de seguridad\n(restauración validada - NFR-14)" as BK
}

cloud "Sistemas externos\nStripe / Revolut, correo, WhatsApp,\nBrain, CRM / ERP" as EXT

' Entrada y seguridad
UO --> WEB
ADM --> WEB
SADM --> WEB
WEB --> API : HTTPS
EXT --> API : consulta y solicitudes\ncontroladas (CU-37)
API --> SEG
SEG ..> MF : usuarios, roles,\nclientes asignados
API --> DOMINIO : delega casos de uso\ny reglas de negocio

' Servicios transversales y persistencia
DOMINIO --> AUD : registra eventos
DOMINIO --> DB : CRUD transaccional
AUD --> DB : append-only
MON --> DB
MON ..> MF : EjecucionTarea

' Planificador y workers
ASYNC --> DOMINIO : J1-J4 procesos periódicos\n(CU-11/12, CU-16, CU-20, CU-23)
J5 --> BK : backup programado
WRK --> DOMINIO : informes (CU-26)\ny reintentos de envío (CU-18)
ASYNC --> MON : registra estado y errores

' Integración: puertos, adaptadores y documentos
DOMINIO --> INTEGRACION : puertos y adaptadores (BR-06),\nCSV (CU-03), PDF (FR-12), envíos (CU-18)\ny sugerencias IA opcionales
INTEGRACION --> DB : guarda PDF factura (FR-12)
INTEGRACION --> FS : guarda informes y adjuntos
INTEGRACION --> EXT : pasarelas, correo, IA\ny sistemas externos

' Copias de seguridad
DB --> BK : copia
FS --> BK : copia documental
BK ..> DB : restauración validada
BK ..> FS : restauración validada

note bottom of AIA
  Opcional: el sistema opera sin ella
  y toda sugerencia económica requiere
  confirmación humana (RB-03, BR-22).
end note
@enduml
