
@startuml diagrama_clases_completo
title Diagrama de clases - Sistema de facturación de Turbine
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
left to right direction
package "Bloque F - Administración, seguridad y sistema" {

  abstract class Usuario {
    - nombre : String
    - correoCorporativo : String
    - hashContrasena : String
    - estado : EstadoUsuario
    - dobleFactorActivo : Boolean
    - intentosFallidos : Integer
    - bloqueadoHasta : FechaHora
    - preferenciasNotificacion : String
    + iniciarSesion(correo : String, contrasena : String) : Boolean
    + recuperarContrasena(correo : String) : void
    + cerrarSesion() : void
    + desactivar() : void
  }

  class UsuarioOperativo {
    + emitirFactura(f : Factura) : void
    + solicitarDescuento(c : Cliente) : SolicitudDescuento
    + conciliarPago(m : MovimientoCobro, f : Factura) : Conciliacion
  }

  class Administrador {
    - puedeGestionarUsuarios : Boolean
    + invitarUsuario(correo : String, rol : String) : Usuario
    + cambiarRol(u : Usuario, rol : String) : void
    + aprobarDescuento(s : SolicitudDescuento) : void
    + aprobarFacturaRetenida(a : AprobacionFactura) : void
  }

  class Superadministrador {
    + resolverEscalado(s : SolicitudDescuento) : void
    + modificarConfiguracion(c : ConfiguracionSistema) : void
    + consultarAuditoria() : List<EventoAuditoria>
  }

  class EventoAuditoria {
    - fechaHora : FechaHora
    - accion : String
    - entidad : String
    - idEntidad : Long
    - valoresAnteriores : String
    - valoresNuevos : String
    - idError : String
  }

  class AccionMasiva {
    - tipo : String
    - numeroElementos : Integer
    - altoImpacto : Boolean
    - estado : EstadoAccionMasiva
    + mostrarAlcance() : Integer
    + confirmar() : void
    + revertir() : void
  }

  class EjecucionTarea {
    - tipo : TipoEjecucion
    - inicio : FechaHora
    - fin : FechaHora
    - estado : EstadoEjecucion
    - resumen : String
    - errores : String
    + reanudar() : void
  }

  class ConfiguracionSistema {
    - datosEmisor : String
    - umbralDescuento : Decimal
    - umbralImporteAlto : Decimal
    - vencimientoGeneralDias : Integer
    - diasRecordatorioPrevio : Integer = 3
    - diasRecordatorioVencimiento : Integer = 5
    - frecuenciaAvisoImpagoDias : Integer = 2
    - funcionesInteligentesActivas : Boolean
    - dominioCorporativo : String
    - diasConservacionInformes : Integer
    + validar() : Boolean
    + admiteCorreo(correo : String) : Boolean
  }

  class SerieFacturacion {
    - codigo : String
    - prefijo : String
    - ultimoNumero : Integer
    + asignarSiguienteNumero() : String
  }

  class Impuesto {
    - nombre : String
    - porcentaje : Decimal
  }

  class RangoTarifa {
    - facturacionMinima : Decimal
    - facturacionMaxima : Decimal
    - precio : Decimal
    - fechaEfecto : Fecha
  }

  class SolicitudExterna {
    - sistemaOrigen : String
    - tipo : String
    - datos : String
    - estado : EstadoSolicitudExterna
    - fecha : FechaHora
    + marcarPendienteRevision() : void
  }
  note bottom of SolicitudExterna
    Del Sistema externo vía API (CU-37).
    Nunca modifica datos directamente (BR-21)
  end note

  enum EstadoUsuario {
    INVITADO
    ACTIVO
    BLOQUEADO
    DESACTIVADO
  }
  enum EstadoAccionMasiva {
    PENDIENTE
    EJECUTADA
    CANCELADA
    REVERTIDA
  }
  enum TipoEjecucion {
    GENERACION_RECURRENTE
    RECORDATORIOS
    CONSULTA_PAGOS
    RESUMEN_DIARIO
    COPIA_SEGURIDAD
  }
  enum EstadoEjecucion {
    EN_CURSO
    COMPLETADA
    COMPLETADA_CON_ERRORES
    INTERRUMPIDA
  }
  enum EstadoSolicitudExterna {
    PENDIENTE_REVISION
    ACEPTADA
    RECHAZADA
  }
}

package "Bloque A - Clientes y contactos" {

  class Cliente {
    - nombreComercial : String
    - razonSocial : String
    - identificadorFiscal : String
    - domicilioFiscal : String
    - pais : String
    - moneda : String
    - sector : String
    - ubicacion : String
    - idioma : String
    - estado : EstadoCliente
    - datosFiscalesIncompletos : Boolean
    - fechaInicio : Fecha
    - condicionesPago : String
    - documentoFirmado : String
    - vencimientoPactadoDias : Integer
    - etiquetas : List<String>
    + darDeAlta() : void
    + editar() : void
    + comprobarDuplicado() : Boolean
    + darDeBaja(fecha : Fecha) : void
    + cambiarResponsable(u : UsuarioOperativo) : void
  }

  class Contacto {
    - nombre : String
    - correo : String
    - idioma : String
    - consentimientoWhatsApp : Boolean
    - activo : Boolean
    + desactivar() : void
    + anonimizar() : void
  }

  class ClienteContacto {
    - tipo : TipoContacto
  }

  class Tarea {
    - descripcion : String
    - fechaPrevista : Fecha
    - estado : EstadoTarea
    - fechaCompletada : FechaHora
    + completar() : void
  }

  class ExcepcionComercial {
    - tipo : TipoExcepcion
    - fechaInicioFutura : Fecha
    - aprobada : Boolean
  }

  class ImportacionCSV {
    - nombreArchivo : String
    - fecha : FechaHora
    - incluyeFacturasHistoricas : Boolean
    - estado : EstadoImportacion
    - creados : Integer
    - actualizados : Integer
    - rechazados : Integer
    + validar() : Boolean
    + previsualizar() : List<FilaImportacion>
    + confirmar() : void
    + cancelar() : void
  }

  class FilaImportacion {
    - numeroFila : Integer
    - estado : EstadoFila
    - motivoError : String
    - marcadaComoActualizacion : Boolean
  }

  enum EstadoCliente {
    ACTIVO
    PENDIENTE_ACTIVACION
    BAJA
  }
  enum TipoContacto {
    CONTRATACION
    FACTURACION
    IMPAGOS
  }
  enum EstadoTarea {
    PENDIENTE
    COMPLETADA
  }
  enum TipoExcepcion {
    INICIO_FUTURO
    PRIMER_MES_GRATIS
    SIN_PRORRATEO
  }
  enum EstadoImportacion {
    PREVISUALIZADA
    CONFIRMADA
    CANCELADA
  }
  enum EstadoFila {
    VALIDA
    ERROR
    DUPLICADO
    DATOS_INCOMPLETOS
    EXCLUIDA
  }
}

package "Bloque B - Suscripciones, tarifas y descuentos" {

  class Suscripcion {
    - plan : String
    - precioVigente : Decimal
    - fechaInicio : Fecha
    - estado : EstadoSuscripcion
    - motivoPausa : String
    - fechaInicioPausa : Fecha
    - fechaReactivacionPrevista : Fecha
    - fechaBaja : Fecha
    - motivoBaja : String
    + pausar(motivo : String, reactivacion : Fecha) : void
    + reactivar() : void
    + darDeBaja(fecha : Fecha) : void
    + esFacturable(periodo : String) : Boolean
    + calcularProrrateo(periodo : String) : Decimal
  }

  class RevisionTarifaAnual {
    - fechaRevision : Fecha
    - facturacionAnualVerificada : Decimal
    - precioAnterior : Decimal
    - precioNuevo : Decimal
    - fechaDecision : FechaHora
    - estado : EstadoRevision
    - motivoRechazo : String
    + aprobar() : void
    + rechazar(motivo : String) : void
  }

  class SolicitudDescuento {
    - tipo : TipoDescuento
    - valor : Decimal
    - motivo : String
    - fechaVigencia : Fecha
    - estado : EstadoDescuento
    - motivoDecision : String
    - fechaDecision : FechaHora
    + superaUmbral() : Boolean
    + aprobar() : void
    + rechazar(motivo : String) : void
    + escalar() : void
  }
  note right of SolicitudDescuento
    Si superaUmbral() decide el Superadministrador
    (FR-18, CU-08 FA-3, CU-09)
    Aprobador distinto del solicitante (BR-12)
  end note

  enum EstadoSuscripcion {
    PENDIENTE_ACTIVACION
    ACTIVA
    EN_PAUSA
    CANCELADA
  }
  enum EstadoRevision {
    PENDIENTE
    APROBADA
    RECHAZADA
  }
  enum TipoDescuento {
    PORCENTAJE
    IMPORTE
  }
  enum EstadoDescuento {
    PENDIENTE
    ESCALADA
    APROBADA
    APROBADA_CONDICIONADA
    RECHAZADA
  }
}

package "Bloque C - Facturación" {

  class Factura {
    - numero : String [0..1]
    - tipo : TipoFactura
    - estado : EstadoFactura
    - fechaEmision : Fecha [0..1]
    - fechaVencimiento : Fecha
    - periodoFacturado : String
    - moneda : String
    - datosFiscalesEmision : String
    - baseImponible : Decimal
    - total : Decimal
    - /saldoPendiente : Decimal
    - retenida : Boolean
    - documentoPDF : Archivo
    - migrada : Boolean
    + calcularTotales() : void
    + validarDatosFiscales() : List<String>
    + detectarCausaRetencion() : String
    + emitir() : void
    + generarPDF() : void
    + registrarCobro(importe : Decimal) : void
    + anular(motivo : String) : void
  }
  note right of Factura
    retenida = tiene una AprobacionFactura PENDIENTE (FR-13)
    En BORRADOR numero y fechaEmision están vacíos.
    datosFiscalesEmision conserva los datos al emitir.
    Emitida = inmutable (BR-09)
  end note

  class AprobacionFactura {
    - motivoRetencion : String
    - estado : EstadoAprobacion
    - fechaSolicitud : FechaHora
    - fechaDecision : FechaHora [0..1]
    - motivoDecision : String
    + aprobar() : void
    + rechazar(motivo : String) : void
    + solicitarInformacion(motivo : String) : void
  }
  note bottom of AprobacionFactura
    Una por cada retención (CU-13 FA-1).
    Aprobador distinto del solicitante (BR-12).
  end note

  class FacturaRectificativa {
    - motivoRectificacion : String
  }

  class LineaFactura {
    - concepto : String
    - cantidad : Decimal
    - precioUnitario : Decimal
    - descuento : Decimal
    - porcentajeImpuesto : Decimal
    - importe : Decimal
    + calcularImporte() : Decimal
  }

  class FiltroGuardado {
    - nombre : String
    - criterios : String
    + aplicar() : void
  }

  class OperacionExcepcional {
    - tipo : TipoOperacion
    - motivo : String
    - estado : EstadoOperacion
    + aprobar() : void
    + ejecutar() : void
  }

  enum TipoFactura {
    PUNTUAL
    RECURRENTE
  }
  enum EstadoFactura {
    BORRADOR
    APROBADA
    EMITIDA
    ENVIADA
    VENCIDA
    PAGADA
    PARCIALMENTE_CONCILIADA
    ANULADA
    RECTIFICADA
    INCOBRABLE
    CANCELADA
  }
  enum EstadoAprobacion {
    PENDIENTE
    PENDIENTE_INFORMACION
    APROBADA
    RECHAZADA
  }
  enum TipoOperacion {
    RECTIFICACION
    ANULACION
    INCOBRABLE
    CANCELACION
  }
  enum EstadoOperacion {
    PENDIENTE
    APROBADA
    RECHAZADA
    EJECUTADA
  }
}

package "Bloque D - Cobros y comunicaciones" {
  interface SistemaPagos {
    + consultarPagos(desde : FechaHora) : List<MovimientoCobro>
  }

  interface CanalEnvio {
    + enviar(c : Comunicacion) : Boolean
  }
  class MovimientoCobro {
    - fuente : FuenteCobro
    - idExterno : String
    - importe : Decimal
    - fecha : FechaHora
    - moneda : String
    - concepto : String
    - referencia : String
    - estado : EstadoMovimiento
    + esDuplicado() : Boolean
  }

  class Conciliacion {
    - importeAsignado : Decimal
    - tipo : TipoConciliacion
    - regla : String
    - fecha : FechaHora
    - revertida : Boolean
    - fechaReversion : FechaHora
    - motivoReversion : String
    + revertir(motivo : String) : void
  }

  class Comunicacion {
    - tipo : TipoComunicacion
    - canal : CanalComunicacion
    - idioma : String
    - estado : EstadoComunicacion
    - fechaEnvio : FechaHora
    - numeroIntento : Integer
    - correoDestinatario : String
    + enviar() : void
    + registrarResultado(resultado : String) : void
    + reenviar(c : Contacto) : Comunicacion
  }
  note bottom of Comunicacion
    Cada intento, reenvío o canal es una Comunicacion:
    el historial queda en la factura (FR-46, CU-18)
  end note

  class PlantillaComunicacion {
    - tipo : TipoComunicacion
    - idioma : String
    - version : Integer
    - asunto : String
    - contenido : String
    + previsualizar() : String
  }

  class SuspensionRecordatorios {
    - motivo : String
    - fechaRevision : Fecha
    - activa : Boolean
    + reanudar() : void
  }

  enum FuenteCobro {
    STRIPE
    REVOLUT
    OTRA
  }
  enum EstadoMovimiento {
    PENDIENTE_CONCILIACION
    PARCIAL
    CONCILIADO
  }
  enum TipoConciliacion {
    AUTOMATICA
    MANUAL
  }
  enum TipoComunicacion {
    FACTURA
    RECORDATORIO_PREVIO
    VENCIMIENTO
    AVISO_IMPAGO
    DISPUTA_RESUELTA
  }
  enum CanalComunicacion {
    EMAIL
    WHATSAPP_SIMULADO
  }
  enum EstadoComunicacion {
    EN_COLA
    ENVIADA
    ENTREGADA
    REBOTADA
    FALLIDA
  }
}
package "Bloque E - Seguimiento, consulta e informes" {
  class Notificacion {
    - categoria : String
    - mensaje : String
    - elementoRelacionado : String
    - fecha : FechaHora
    - requiereAccion : Boolean
    - leida : Boolean
    - resuelta : Boolean
    + marcarLeida() : void
    + marcarResuelta() : void
  }

  class ReglaAlerta {
    - tipo : TipoAlerta
    - umbral : Decimal
    - activa : Boolean
    + evaluar() : Boolean
  }

  class Incidencia {
    - tipo : TipoIncidencia
    - descripcion : String
    - estado : EstadoIncidencia
    - prioridad : Prioridad
    - fechaCreacion : FechaHora
    - adjuntos : List<String>
    + resolver(comentario : String) : void
  }
  class Comentario {
    - texto : String
    - fecha : FechaHora
  }
  note bottom of Comentario
    Siempre interno: nunca se envía
    al cliente (BR-20)
  end note

  class Informe {
    - filtros : String
    - formato : FormatoInforme
    - estado : EstadoInforme
    - fechaGeneracion : FechaHora
    - fechaCaducidad : FechaHora
    + generar() : void
    + exportar() : String
    + regenerar() : void
  }

  class ObjetivoFacturacion {
    - periodo : String
    - valor : Decimal
    + modificar(valor : Decimal) : void
  }

  class CentroCoste {
    - nombre : String
    - tipo : TipoCentroCoste
    - activo : Boolean
  }

  enum TipoAlerta {
    DIAS_VENCIDA
    IMPORTE_PENDIENTE
  }
  enum TipoIncidencia {
    ENTREGA
    COBRO
    FACTURACION
    OTRA
  }
  enum EstadoIncidencia {
    ABIERTA
    EN_CURSO
    RESUELTA
    CERRADA
  }
  enum Prioridad {
    BAJA
    MEDIA
    ALTA
  }
  enum FormatoInforme {
    CSV
    PDF
  }
  enum EstadoInforme {
    PENDIENTE
    PROCESANDO
    COMPLETADO
    COMPLETADO_CON_ERRORES
  }
  enum TipoCentroCoste {
    CENTRO_COSTE
    PROYECTO
  }
}
Usuario <|-- UsuarioOperativo
UsuarioOperativo <|-- Administrador
Administrador <|-- Superadministrador
Factura <|-- FacturaRectificativa

