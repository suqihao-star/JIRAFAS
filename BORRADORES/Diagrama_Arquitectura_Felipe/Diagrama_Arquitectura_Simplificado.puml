@startuml arquitectura_turbine_limpia
title Arquitectura Software - Sistema de Facturación de TurbineH
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 45
top to bottom direction

' === 1. ACTORES Y SISTEMAS EXTERNOS (ENTRADA) ===
actor "Usuario Operativo\n/ Admin / Superadmin" as Users
cloud "Sistema Externo\n(CRM / ERP)" as ExtSys

' === 2. CAPA DE ACCESO E INTERFAZ ===
package "Capa de Acceso e Interfaz" {
  [Aplicación Web Responsive\n(Ordenador, Móvil y Tablet)] as WebApp
  [API Documentada y Segura\n(Consultas y Solicitudes Externas)] as PublicAPI
}

' === 3. BLOQUE F - GOBIERNO, SEGURIDAD Y AUTOMATIZACIÓN ===
package "Bloque F - Administración, seguridad y sistema" as BloqueF {
  [Control de Acceso y Roles\n(Login Corporativo, 2FA, Permisos)] as AuthSec
  [Configuración del Sistema\n(Series, Impuestos, Tarifas, Plazos)] as SysConfig
  [Auditoría y Monitorización\n(Historial Inmutable, Colas y Backups)] as AuditMon
  [Planificador de Tareas\n(Día 1, Cobros, Avisos y Backups)] as Scheduler
  [Control de Solicitudes Externas\ny Acciones Masivas] as ExtAndBulk
}

' === 4. NÚCLEO OPERATIVO DE NEGOCIO (BLOQUES A - E) ===
package "Núcleo Operativo de Negocio" as CoreBiz {

  package "Bloque A - Clientes y contactos" as BloqueA {
    [Fichas, Contactos y Duplicados] as ClientMgmt
    [Tareas y Excepciones Comerciales] as TasksExc
    [Importador Masivo CSV] as CSVImport
  }

  package "Bloque B - Suscripciones, tarifas y descuentos" as BloqueB {
    [Ciclo de Suscripciones y Prorrateo] as SubMgmt
    [Revisión de Tarifas y Descuentos] as PricingDisc
  }

  package "Bloque C - Facturación" as BloqueC {
    [Motor de Facturación y Series] as BillingEngine
    [Aprobaciones, Retenciones y Rectificativas] as ApprovalsRect
    [Generador de Facturas PDF] as PDFGen
  }

  package "Bloque E - Seguimiento, consulta e informes" as BloqueE {
    [Trabajo Diario, Alertas y Notificaciones] as DailyWork
    [Incidencias y Comentarios Internos] as IssuesMgr
    [Dashboard Financiero e Informes] as ReportsDash
  }

  package "Bloque D - Cobros y comunicaciones" as BloqueD {
    [Conciliación de Cobros] as Reconcil
    [Gestor de Envíos y Recordatorios] as CommsMgr
  }

  [Módulo de IA Opcional (Brain)\n(Asistente Supervisado)] as OptionalAI
}

' === 5. ALMACENAMIENTO Y CONECTORES DE SALIDA ===
package "Almacenamiento de Datos y Respaldos" as StoragePkg {
  database "Base de Datos Principal\n(Precisión Decimal Exacta)" as MainDB
  folder "Almacén Seguro de Archivos\n(PDFs, Contratos, Adjuntos, Informes)" as FileRepo
  database "Copias de Seguridad\n(Respaldos Automáticos y Restauración)" as BackupRepo
}

package "Conectores de Integración Externa" as ConnectorsPkg {
  [Conector Pasarelas de Pago\n(Stripe, Revolut y Otras)] as PayConnector
  [Conector de Mensajería\n(Correo y WhatsApp Simulado)] as MsgConnector
}

cloud "Pasarelas de Pago\n(Stripe / Revolut)" as ExtPay
cloud "Proveedores de Correo\ny WhatsApp" as ExtMsg

' === ORDENACIÓN INTERNA PARA EVITAR CRUCES ===
BloqueA -[hidden]-> BloqueE
BloqueB -[hidden]-> OptionalAI
BloqueC -[hidden]-> BloqueD

' === CONEXIONES DE ENTRADA ===
Users --> WebApp
ExtSys --> PublicAPI : HTTPS / Token

WebApp --> AuthSec : Valida sesión
PublicAPI --> AuthSec : Valida permisos
PublicAPI --> ExtAndBulk : Cola de revisión\n(BR-21)

' === RELACIÓN BLOQUE F CON EL NÚCLEO ===
AuthSec --> CoreBiz : Controla acceso
SysConfig --> CoreBiz : Aplica reglas y tarifas
Scheduler --> CoreBiz : Ejecuta procesos automáticos
CoreBiz ..> AuditMon : Registra eventos

' === FLUJO PRINCIPAL ENTRE BLOQUES (A -> B -> C -> D -> E) ===
BloqueA -right-> BloqueB : Cliente y excepciones
BloqueB -right-> BloqueC : Cuotas y descuentos
BloqueC -down-> BloqueD : Facturas emitidas
BloqueD -left-> BloqueE : Impagos y rebotes
BloqueA -down-> BloqueE : Actividad e incidencias

OptionalAI .left.> BloqueB : Sugerencias\n(con aprobación)
OptionalAI .left.> BloqueE : Apoyo análisis

' === CONEXIONES A PERSISTENCIA Y COPIAS DE SEGURIDAD ===
CoreBiz -down-> MainDB : Datos operativos
BloqueF -down-> MainDB : Configuración y auditoría
CoreBiz -down-> FileRepo : PDFs y documentos

MainDB -down-> BackupRepo : Respaldo datos
FileRepo -down-> BackupRepo : Respaldo archivos
Scheduler -down-> BackupRepo : Dispara backup

' === CONEXIONES A SERVICIOS EXTERNOS ===
BloqueD -down-> PayConnector : Consulta cobros
BloqueD -down-> MsgConnector : Envía avisos

PayConnector -down-> ExtPay
MsgConnector -down-> ExtMsg

@enduml