@startuml SEC_04_CU-12_emitir_factura
' =====================================================================
'  DIAGRAMA DE SECUENCIA 4 - CU-12 Emitir factura
'  Sistema de facturación de Turbine - Grupo JIRAFAS - Entrega 2
'  Flujo principal (manual) + FA-1 (retención -> CU-13), FA-2 (emisión
'  recurrente desde CU-11), FA-3 (fallo de envío), FE-1 (dato fiscal),
'  FE-2 (duplicidad / concurrencia), FE-3 (no se puede generar el PDF).
'  Clases: diagrama_clases_simplificado (propuesta nueva Pablo F. C.)
' =====================================================================
skinparam sequenceMessageAlign center
skinparam maxMessageSize 170
skinparam ParticipantPadding 12
hide footbox
autonumber
title CU-12 - Emitir factura

actor "Usuario operativo" as UO
control ":Sistema" as SYS
participant "f : Factura" as F
participant "lf : LineaFactura" as LF
participant "c : Cliente" as C
participant "cfg : ConfiguracionSistema" as CFG
participant "s : SerieFacturacion" as SER

alt [emisión manual]
  UO -> SYS : emitirFactura(idFactura)
else [FA-2: mensualidad autorizada desde CU-11]
  [-> SYS : emitirMensualidad(f)
  note left of SYS : invocado por CU-11\n(ref en SEC_03)
end
activate SYS
SYS -> SYS : comprobarAutorizacion(origen, f)
break [el actor no tiene permiso sobre el cliente o la factura]
  alt [origen manual]
    SYS --> UO : acceso denegado
  else [origen recurrente]
    [<-- SYS : emisión no autorizada
  end
end

SYS -> F ++ : getEstado()
return estado
break [FE-2: la factura ya tiene emisión definitiva]
  alt [origen manual]
    SYS --> UO : devuelve la factura ya emitida (no se duplica)
  else [origen recurrente]
    [<-- SYS : ya emitida: no se duplica
  end
end

SYS -> F ++ : validarDatosFiscales()
F -> C ++ : getIdentificadorFiscal(), getDomicilioFiscal()
return datos fiscales
return valido : Boolean
break [FE-1: falta un dato fiscal imprescindible]
  alt [origen manual]
    SYS --> UO : bloquea la emisión ANTES de numerar\ne indica los datos a corregir
  else [origen recurrente]
    [<-- SYS : pendiente: datos fiscales incompletos
  end
end

SYS -> F ++ : calcularTotales()
loop [para cada línea]
  F -> LF ++ : calcularImporte()
  return importe
end
return
opt [emisión manual]
  SYS --> UO : vista previa: importes, datos fiscales\ny condiciones de pago (FR-20)
  UO -> SYS : confirmarEmision()
end

SYS -> CFG ++ : getUmbralImporteAlto()
return umbral
SYS -> SYS : comprobarRetencion(f, umbral, aprobación vigente)

alt [FA-1: cambio sensible o importe elevado sin aprobación]
  SYS -> F : setRetenida(true), setMotivoRetencion(motivo)
  create participant "n : Notificacion" as N
  SYS -->> N : <<create>> Notificacion("FACTURA_RETENIDA", motivo)
  note right of N : para el Administrador; se explica\nel motivo de la retención (FR-18)
  ref over SYS, F : CU-13 Aprobar factura retenida («extend»)
  note right of F : si CU-13 la aprueba, la emisión se retoma\nen la sección crítica de numeración (paso 6);\nsi la rechaza, vuelve a BORRADOR para corregirla
  alt [origen manual]
    SYS --> UO : factura retenida pendiente de aprobación
  else [origen recurrente]
    [<-- SYS : mensualidad retenida
  end

else [sin retención]
  critical emisión única por obligación y serie
    SYS -> SYS : revalidar autorización, estado, datos fiscales\ny condiciones económicas aprobadas
    note right of SYS : segunda comprobación de FE-1 / FE-2 dentro\nde la sección crítica: otro intento concurrente\npudo emitirla o cambiar los datos
    alt [FE-2: otro intento ya la emitió]
      SYS -> SYS : recuperar la factura existente (sin numerar otra vez)
    else [FE-1: los datos fiscales ya no son válidos]
      SYS -> SYS : bloquear ANTES de numerar
    else [permiso revocado o condiciones económicas modificadas]
      SYS -> SYS : bloquear la emisión y pedir nueva revisión
    else [emisión pendiente y autorizada]
      SYS -> F ++ : emitir()
      F -> F : getNumero()
      alt [FE-3: ya tiene número reservado (reintento tras fallo del PDF)]
        note right of F : se reutiliza: no se consume\notro número de la serie
      else [sin número (primer intento)]
        F -> SER ++ : asignarSiguienteNumero()
        note right of SER : número correlativo\núnico en la serie
        return numero
        F -> F : setNumero(numero)
      end
      F -> F : generarPDF()
      alt [FE-3: fallo al generar o conservar el PDF]
        F --> SYS : emisión no confirmada
        note right of F : se registra el error. El número queda\nligado a ESTA factura para el reintento:\nno se crea otra ni se consume otro número
      else [PDF válido y conservado]
        F -> F : setEstado(EMITIDA)
        note right of F : inmutable (BR-09, FR-14)
        F --> SYS : factura emitida
        create participant "ev : EventoAuditoria" as EV
        SYS -->> EV : <<create>> EventoAuditoria("EMITIR", "Factura", f.id)
      end
      deactivate F
    end
  end

  opt [emisión nueva confirmada]
    ref over SYS, F : CU-18 Enviar comunicación al cliente\n(tipo FACTURA, contacto de facturación)
    alt [envío completado]
      critical [paso a ENVIADA sin interferir con un cobro concurrente]
        SYS -> F ++ : getEstado()
        return estado actual
        opt [estado actual = EMITIDA]
          SYS -> F : setEstado(ENVIADA)
          note right of F : no se pisa un estado de cobro\n(PAGADA, PARCIALMENTE_CONCILIADA)\nsi el pago llegó antes que el envío
        end
      end
    else [FA-3: fallo de envío]
      SYS -> SYS : registrar el fallo
      note right of SYS : la factura sigue EMITIDA con el mismo\nnúmero y PDF; el reintento no la reemite
    end
  end
  alt [origen manual]
    SYS --> UO : resultado de la emisión y del envío
  else [origen recurrente]
    [<-- SYS : resultado para el resumen de CU-11
  end
end
deactivate SYS
@enduml
