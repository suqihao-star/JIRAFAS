@startuml SEC_06_CU-17_conciliar_pagos
' =====================================================================
'  DIAGRAMA DE SECUENCIA 6 - CU-17 Conciliar pagos (manual)
'  Sistema de facturación de Turbine - Grupo JIRAFAS - Entrega 2
'  Flujo principal + FA-2 (un cobro para varias facturas),
'  FE-1 (importe superior), FE-2 (movimiento ya conciliado).
'  FA-1 (automática) está en SEC_05; FA-3 (deshacer) en anexo/SEC_06b.
'  Clases: diagrama_clases_simplificado (propuesta nueva Pablo F. C.)
' =====================================================================
skinparam sequenceMessageAlign center
skinparam maxMessageSize 170
skinparam ParticipantPadding 12
hide footbox
autonumber
title CU-17 - Conciliar pagos (manual)

actor "Usuario operativo" as UO
control ":Sistema" as SYS
participant "u : UsuarioOperativo" as U
participant "m : MovimientoCobro" as M
participant "f : Factura" as F

UO -> SYS : verMovimientosPendientes()
activate SYS
SYS -> SYS : filtrarPorAmbitoAutorizado(u, movimientos)
SYS --> UO : movimientos autorizados con importe,\nfecha, concepto y referencia
UO -> SYS : seleccionarMovimiento(idMovimiento)
SYS -> M ++ : getEstado()
return estado

break [FE-2: el movimiento ya está conciliado]
  SYS --> UO : impide asociarlo de nuevo
end

SYS -> SYS : filtrarPorAmbitoAutorizado(u, facturas)
SYS --> UO : facturas pendientes autorizadas
UO -> SYS : asociar(m, facturas[], importes[])
SYS -> SYS : comprobarAsignacion(u, cliente)
SYS -> SYS : validarImportes(m, facturas, importes)

alt [PRE-3: cliente no asignado y el usuario no es Administrador]
  SYS --> UO : acceso denegado; sin cambios
else [FE-1: un importe supera el saldo pendiente de la factura]
  SYS --> UO : señala la diferencia; la factura NO\nse marca como pagada (FR-21)
  note right of UO : corrige la asociación (vuelve al paso 4)\no deja la diferencia pendiente de revisión
else [FA-2: la suma repartida no coincide con el importe disponible del movimiento]
  SYS --> UO : la suma no coincide; corregir el reparto
else [moneda incompatible, importe no positivo o factura no cobrable]
  SYS --> UO : corregir los datos; sin cambios
else [importes válidos]
  critical conciliación atómica
    SYS -> SYS : revalidar permisos, importe disponible, moneda,\nestado del movimiento y saldos actuales
    alt [permiso revocado o conflicto concurrente]
      SYS --> UO : operación no aplicada; actualizar los datos
    else [validación vigente]
      loop [para cada factura asociada]
        SYS -> U ++ : conciliarPago(m, f)
        create participant "con : Conciliacion" as CON
        U -->> CON : <<create>> Conciliacion(m, f, tipo = MANUAL,\nrealizadaPor = u)
        return con
        SYS -> CON : setImporteAsignado(importe validado)
        note right of CON : conciliarPago(m, f) no recibe el importe\n(diferencia con el modelo, ver .md): se fija\naquí, dentro de la misma transacción
        SYS -> F ++ : getSaldoPendiente()
        return saldo
        SYS -> F : setSaldoPendiente(saldo - importeAsignado)
        alt [saldo resultante = 0]
          SYS -> F : setEstado(PAGADA)
        else [saldo resultante > 0]
          SYS -> F : setEstado(PARCIALMENTE_CONCILIADA)
        end
      end
      SYS -> M ++ : getConciliaciones()
      return conciliaciones vigentes
      SYS -> M : setEstado(CONCILIADO si todo su importe está asignado;\nsi no, PENDIENTE por la parte libre)
      create participant "ev : EventoAuditoria" as EV
      SYS -->> EV : <<create>> EventoAuditoria("CONCILIAR", "MovimientoCobro", m.id)
      SYS --> UO : conciliación confirmada (quién y cuándo)
    end
  end
end
deactivate SYS

@enduml
