@startuml diagrama_clases_completo
skinparam backgroundColor #FFFFFF
skinparam linetype polyline
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 45
skinparam ranksep 55
skinparam ArrowColor #3B4456
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #2C4F94
  HeaderBackgroundColor #E6ECF7
}
skinparam enum {
  BackgroundColor #FBF6EA
  BorderColor #8A6A2A
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #2C4F94
}
skinparam note {
  BackgroundColor #FFFDF3
  BorderColor #C9B98A
  FontSize 11
}
skinparam package {
  BorderColor #9AA4B5
  FontColor #3B4456
}
hide empty members
left to right direction
title Diagrama de clases completo - Sistema de facturación TurbineH

package "Bloque A - Clientes y contactos" {
  class Cliente {
    - id : Long
    - nombreComercial : String
    - razonSocial : String
    - identificadorFiscal : String [0..1]
    - domicilioFiscal : String
    - pais : String
    - moneda : String
    - idioma : String
    - sector : String
    - ubicacion : String
    - etiquetas : List<String>
    - estado : EstadoCliente
    - condicionesPago : String
    - vencimientoPactadoDias : Integer [0..1]
    - refDocumentoFirmado : String [0..1]
    - version : Integer
    + datosFiscalesCompletos() : Boolean
    + camposFiscalesPendientes() : List<String>
    + buscarDuplicados() : List<Cliente>
    + cambiarResponsable(u : Usuario) : void
    + saldoPendiente() : Decimal
  }
  enum EstadoCliente {
    PENDIENTE_ACTIVACION
    ACTIVO
    BAJA
  }
  class Contacto {
    - id : Long
    - nombre : String
    - correo : String
    - telefono : String [0..1]
    - idioma : String
    - consentimientoWhatsApp : Boolean
    - activo : Boolean
    - anonimizado : Boolean
    + desactivar() : void
    + anonimizar() : void
  }
  class ClienteContacto {
    - tipo : TipoContacto
    - activo : Boolean
  }
  enum TipoContacto {
    CONTRATACION
    FACTURACION
    IMPAGOS
  }
  class Tarea {
    - descripcion : String
    - fechaPrevista : Fecha [0..1]
    - completada : Boolean
    - fechaCompletada : FechaHora [0..1]
    - version : Integer
    + completar(u : Usuario) : void
  }
  class ExcepcionComercial {
    - tipo : TipoExcepcion
    - fechaEfecto : Fecha
    - motivo : String
    + tieneEfectoEconomico() : Boolean
    + estaAprobada() : Boolean
  }
  enum TipoExcepcion {
    PRIMER_MES_GRATIS
    SIN_PRORRATEO
    INICIO_FUTURO
  }
  class ImportacionCSV {
    - nombreArchivo : String
    - fecha : FechaHora
    - incluyeFacturasHistoricas : Boolean
    - estado : EstadoImportacion
    - creados : Integer
    - actualizados : Integer
    - rechazados : Integer
    + validar() : Boolean
    + previsualizar() : List<FilaImportacion>
    + confirmar() : void
  }
  class FilaImportacion {
    - numeroFila : Integer
    - estado : EstadoFila
    - motivo : String [0..1]
    - posibleDuplicado : Boolean
    - marcadaComoActualizacion : Boolean
  }
  enum EstadoImportacion {
    EN_PREVISUALIZACION
    CONFIRMADA
    CANCELADA
    FALLIDA
  }
  enum EstadoFila {
    VALIDA
    CON_ERROR
    EXCLUIDA
  }
}

package "Bloque B - Suscripciones, tarifas y descuentos" {
  class Suscripcion {
    - id : Long
    - planServicio : String
    - fechaInicio : Fecha
    - precioAcordado : Decimal
    - estado : EstadoSuscripcion
    - fechaBaja : Fecha [0..1]
    - motivoBaja : String [0..1]
    - version : Integer
    + esFacturable(periodo : String) : Boolean
    + calcularProrrateo(fechaAlta : Fecha) : Decimal
    + pausar(motivo : String, inicio : Fecha, reactivacion : Fecha) : void
    + reactivar() : void
    + darDeBaja(fecha : Fecha, motivo : String) : void
  }
  enum EstadoSuscripcion {
    PENDIENTE_ACTIVACION
    ACTIVA
    PAUSADA
    BAJA
  }
  class Pausa {
    - motivo : String
    - fechaInicio : Fecha
    - fechaReactivacionPrevista : Fecha [0..1]
    - fechaFin : Fecha [0..1]
  }
  abstract class SolicitudAprobacion {
    - id : Long
    - fechaSolicitud : FechaHora
    - motivo : String
    - estado : EstadoAprobacion
    - nivelRequerido : NivelAprobacion
    - motivoPendiente : String
    - fechaResolucion : FechaHora [0..1]
    - motivoResolucion : String [0..1]
    - version : Integer
    + aprobar(u : Usuario) : void
    + rechazar(u : Usuario, motivo : String) : void
    + escalar() : void
    + pedirInformacion(texto : String) : void
    # puedeResolver(u : Usuario) : Boolean
  }
  enum EstadoAprobacion {
    PENDIENTE
    ESCALADA
    INFO_SOLICITADA
    APROBADA
    RECHAZADA
  }
  enum NivelAprobacion {
    ADMINISTRADOR
    SUPERADMINISTRADOR
  }
  class SolicitudDescuento {
    - tipo : TipoDescuento
    - valor : Decimal
    - vigenciaDesde : Fecha
    - vigenciaHasta : Fecha [0..1]
    + superaUmbral(umbral : Decimal) : Boolean
  }
  enum TipoDescuento {
    PORCENTAJE
    IMPORTE_FIJO
  }
  class RevisionTarifa {
    - facturacionAnualVerificada : Decimal
    - precioAnterior : Decimal
    - precioNuevo : Decimal
  }
  class AprobacionExcepcion
}

package "Bloque C - Facturación" {
  class Factura {
    - id : Long
    - numero : String [0..1]
    - tipo : TipoFactura
    - estado : EstadoFactura
    - fechaEmision : Fecha [0..1]
    - fechaVencimiento : Fecha
    - periodoFacturado : String [0..1]
    - moneda : String
    - baseImponible : Decimal
    - totalImpuestos : Decimal
    - total : Decimal
    - importePendiente : Decimal
    - migrada : Boolean
    - rutaPDF : String [0..1]
    - hashPDF : String [0..1]
    - claveIdempotencia : String
    - version : Integer
    + calcularTotales() : void
    + validarDatosFiscales() : List<String>
    + detectarCausaRetencion() : CausaRetencion [0..1]
    + emitir() : void
    + generarPDF() : void
    + estaBloqueada() : Boolean
    + registrarCobro(importe : Decimal) : void
  }
  enum TipoFactura {
    PUNTUAL
    RECURRENTE
  }
  enum EstadoFactura {
    BORRADOR
    APROBADA
    EMITIDA
    ENVIADA
    VENCIDA
    PARCIALMENTE_CONCILIADA
    PAGADA
    ANULADA
    RECTIFICADA
    INCOBRABLE
    CANCELADA
  }
  class FacturaRectificativa {
    - motivoRectificacion : String
  }
  class LineaFactura {
    - orden : Integer
    - concepto : String
    - cantidad : Decimal
    - precioUnitario : Decimal
    - descuento : Decimal
    - importeImpuesto : Decimal
    - subtotal : Decimal
    + calcularSubtotal() : Decimal
  }
  class DatosFiscalesFactura {
    - razonSocialCliente : String
    - idFiscalCliente : String
    - domicilioCliente : String
    - paisCliente : String
    - razonSocialEmisor : String
    - idFiscalEmisor : String
    - domicilioEmisor : String
  }
  class AprobacionFactura {
    - causa : CausaRetencion
  }
  enum CausaRetencion {
    IMPORTE_MODIFICADO
    DESCUENTO_EXTRAORDINARIO
    VENCIMIENTO_ATIPICO
    IMPORTE_ALTO
  }
  class OperacionExcepcional {
    - tipo : TipoOperacion
    - importe : Decimal
    + ejecutar() : void
  }
  enum TipoOperacion {
    RECTIFICACION
    ANULACION
    INCOBRABLE
    CANCELACION
  }
  class PeriodoFiscal {
    - anio : Integer
    - trimestre : Integer
    - fechaPresentacion : Fecha
    - cerrado : Boolean
    - fechaReapertura : FechaHora [0..1]
    - motivoReapertura : String [0..1]
    + cerrar() : void
    + reabrir(u : Usuario, motivo : String) : void
  }
  class FiltroGuardado {
    - nombre : String
    - ambito : String
    - criterios : String
    + aplicar() : void
  }
}

package "Bloque D - Cobros y comunicaciones" {
  interface SistemaPagos {
    + consultarMovimientos(desde : FechaHora) : List<MovimientoCobro>
    + recibirNotificacion(evento : String) : MovimientoCobro
  }
  class ConectorStripe
  class ConectorRevolut
  class MovimientoCobro {
    - id : Long
    - idEventoExterno : String
    - importe : Decimal
    - moneda : String
    - fecha : FechaHora
    - concepto : String
    - referencia : String [0..1]
    - estado : EstadoMovimiento
    - fechaRegistro : FechaHora
    + esDuplicado() : Boolean
    + importeSinConciliar() : Decimal
  }
  enum EstadoMovimiento {
    PENDIENTE_CONCILIACION
    CONCILIADO_PARCIAL
    CONCILIADO
  }
  class Conciliacion {
    - importeAplicado : Decimal
    - fecha : FechaHora
    - tipo : TipoConciliacion
    - reglaAplicada : String [0..1]
    - revertida : Boolean
    - fechaReversion : FechaHora [0..1]
    - motivoReversion : String [0..1]
    + revertir(u : Usuario, motivo : String) : void
  }
