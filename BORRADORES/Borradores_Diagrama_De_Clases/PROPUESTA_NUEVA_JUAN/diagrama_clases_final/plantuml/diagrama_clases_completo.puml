package "Bloque F - Administración, seguridad y sistema" {
  class Usuario {
    - id : Long
    - nombre : String
    - correoCorporativo : String
    - hashContrasena : String
    - rol : Rol
    - estado : EstadoUsuario
    - dobleFactorActivo : Boolean
    - intentosFallidos : Integer
    - bloqueadoHasta : FechaHora [0..1]
    - version : Integer
    + iniciarSesion(correo : String, contrasena : String) : Sesion
    + solicitarRecuperacion(correo : String) : void
    + cambiarRol(r : Rol) : void
    + desactivar() : void
    + tienePermiso(codigo : String) : Boolean
    + puedeAcceder(c : Cliente) : Boolean
  }
  enum Rol {
    SUPERADMINISTRADOR
    ADMINISTRADOR
    USUARIO_OPERATIVO
  }
  enum EstadoUsuario {
    INVITADO
    ACTIVO
    BLOQUEADO
    DESACTIVADO
  }
  class Permiso {
    - codigo : String
    - descripcion : String
  }
  class Sesion {
    - tokenHash : String
    - inicio : FechaHora
    - expiracion : FechaHora
    - invalidada : Boolean
    + estaVigente() : Boolean
    + invalidar() : void
  }
  class EnlaceTemporal {
    - tokenHash : String
    - tipo : TipoEnlace
    - expiracion : FechaHora
    - usado : Boolean
    + esValido() : Boolean
    + consumir() : void
  }
  enum TipoEnlace {
    INVITACION
    RECUPERACION_CONTRASENA
  }
  class EventoAuditoria {
    - id : Long
    - fechaHora : FechaHora
    - accion : String
    - tipoEntidad : String
    - idEntidad : Long
    - valoresAnteriores : String [0..1]
    - valoresNuevos : String [0..1]
    - idError : String [0..1]
  }
  class AccionMasiva {
    - tipo : TipoAccionMasiva
    - numeroElementos : Integer
    - altoImpacto : Boolean
    - estado : EstadoAccion
    - fecha : FechaHora
    + mostrarAlcance() : Integer
    + confirmar() : void
    + ejecutar() : void
  }
  enum TipoAccionMasiva {
    REASIGNAR_CLIENTES
    ETIQUETAR_CLIENTES
    ASIGNAR_CENTRO_COSTE
  }
  enum EstadoAccion {
    PENDIENTE_CONFIRMACION
    PENDIENTE_APROBACION
    EJECUTADA
    CANCELADA
    FALLIDA
  }
  class EjecucionTarea {
    - tipo : TipoTarea
    - inicio : FechaHora
    - fin : FechaHora [0..1]
    - estado : EstadoEjecucion
    - procesados : Integer
    - errores : Integer
    - resumen : String
    + reanudar() : void
  }
  enum TipoTarea {
    GENERACION_RECURRENTE
    RECORDATORIOS
    CONSULTA_PAGOS
    EVALUACION_ALERTAS
    RESUMEN_DIARIO
    COPIA_SEGURIDAD
  }
  enum EstadoEjecucion {
    EN_CURSO
    COMPLETADA
    CON_ERRORES
    INTERRUMPIDA
  }
  class ErrorTecnico {
    - idError : String
    - origen : String
    - mensaje : String
    - fecha : FechaHora
  }
  class ConfiguracionSistema {
    - razonSocialEmisor : String
    - idFiscalEmisor : String
    - domicilioEmisor : String
    - dominiosAutorizados : List<String>
    - umbralDescuento : Decimal
    - umbralImporteAlto : Decimal
    - vencimientoGeneralDias : Integer
    - diasRecordatorioPrevio : Integer = 3
    - diasRecordatorioVencimiento : Integer = 5
    - frecuenciaAvisoImpagoDias : Integer = 2
    - diasConservacionInformes : Integer
    + validar() : Boolean
    + admiteCorreo(correo : String) : Boolean
  }
  class FuncionInteligente {
    - codigo : String
    - descripcion : String
    - activa : Boolean
  }
  class SerieFacturacion {
    - codigo : String
    - prefijo : String
    - ultimoNumero : Long
    - activa : Boolean
    + asignarSiguienteNumero() : String
  }
  class Impuesto {
    - nombre : String
    - porcentaje : Decimal
    - activo : Boolean
  }
  class RangoTarifa {
    - facturacionMinima : Decimal
    - facturacionMaxima : Decimal
    - precio : Decimal
    - fechaEfecto : Fecha
    - vigente : Boolean
  }
  class ClienteAPI {
    - nombre : String
    - hashCredencial : String
    - activo : Boolean
    - expiracion : FechaHora
  }
  class SolicitudExterna {
    - tipo : TipoSolicitudExterna
    - datos : String
    - estado : EstadoAprobacion
    - fecha : FechaHora
    + marcarPendienteRevision() : void
  }
  enum TipoSolicitudExterna {
    BAJA_CLIENTE
    CAMBIO_DATOS_CONTACTO
  }
}

Cliente "0..*" --> "1" Usuario : responsableInterno
Usuario "0..*" -- "0..*" Cliente : asignadoA >
Usuario "0..*" -- "0..*" Cliente : favoritos >
Cliente "1..*" -- "0..*" Contacto
(Cliente, Contacto) .. ClienteContacto
Cliente "1" *-- "0..*" Tarea
Tarea "0..*" --> "0..1" Usuario : completadaPor
Cliente "1" *-- "0..*" ExcepcionComercial
Usuario "1" -- "0..*" ImportacionCSV : realiza >
ImportacionCSV "1" *-- "1..*" FilaImportacion
FilaImportacion "0..*" --> "0..1" Cliente : creaOActualiza
FilaImportacion "0..*" --> "0..1" Factura : facturaMigrada
Cliente "1" *-- "1..*" Suscripcion
Suscripcion "1" *-- "0..*" Pausa
Suscripcion "0..*" --> "1" RangoTarifa : tarifaAplicada
SolicitudAprobacion <|-- SolicitudDescuento
SolicitudAprobacion <|-- RevisionTarifa
SolicitudAprobacion <|-- AprobacionExcepcion
SolicitudAprobacion <|-- AprobacionFactura
SolicitudAprobacion <|-- OperacionExcepcional
SolicitudAprobacion "0..*" --> "1" Usuario : solicitante
SolicitudAprobacion "0..*" --> "0..1" Usuario : aprobador
SolicitudDescuento "0..*" --> "1" Suscripcion : sobre
RevisionTarifa "0..*" --> "1" Suscripcion : sobre
RevisionTarifa "0..*" --> "1" RangoTarifa : rangoPropuesto
AprobacionExcepcion "0..1" --> "1" ExcepcionComercial : aprueba
Suscripcion "0..1" -- "0..*" Factura : genera >
Cliente "1" -- "0..*" Factura
Factura "1" *-- "1..*" LineaFactura
LineaFactura "0..*" --> "1" Impuesto
SerieFacturacion "1" -- "0..*" Factura : numera >
Factura "1" *-- "0..1" DatosFiscalesFactura
Factura <|-- FacturaRectificativa
FacturaRectificativa "0..1" --> "1" Factura : rectificaA
Factura "0..*" --> "1" PeriodoFiscal
PeriodoFiscal "0..*" --> "0..1" Usuario : reabiertoPor
Factura "0..*" --> "0..1" SolicitudDescuento : descuentoAplicado
AprobacionFactura "0..*" --> "1" Factura : retiene
OperacionExcepcional "0..*" --> "1" Factura : sobre
OperacionExcepcional "0..1" --> "0..1" FacturaRectificativa : genera
Factura "0..*" --> "0..1" EjecucionTarea : generadaEn
Usuario "1" *-- "0..*" FiltroGuardado
SistemaPagos <|.. ConectorStripe
SistemaPagos <|.. ConectorRevolut
SistemaPagos ..> MovimientoCobro : proporciona
MovimientoCobro "0..*" -- "0..*" Factura
(MovimientoCobro, Factura) .. Conciliacion
Conciliacion "0..*" --> "0..1" Usuario : realizadaPor
Conciliacion "0..*" --> "0..1" Usuario : revertidaPor
MovimientoCobro "0..*" --> "0..1" Usuario : asignadoA
DiferenciaCobro "0..*" --> "1" Factura
DiferenciaCobro "0..*" --> "1" MovimientoCobro
Cliente "1" -- "0..*" Comunicacion
Factura "0..1" -- "0..*" Comunicacion
Comunicacion "1" *-- "1..*" IntentoEnvio
IntentoEnvio "0..*" --> "0..1" Contacto : destinatario
Comunicacion "0..*" --> "1" VersionPlantilla : usa
PlantillaComunicacion "1" *-- "1..*" VersionPlantilla
VersionPlantilla "0..*" --> "1" Usuario : autor
CanalEnvio <|.. ProveedorCorreo
CanalEnvio <|.. SimuladorWhatsApp
