    AUTOMATICA
    MANUAL
  }
  class DiferenciaCobro {
    - importe : Decimal
    - tipo : TipoDiferencia
    - revisada : Boolean
  }
  enum TipoDiferencia {
    PAGO_INSUFICIENTE
    PAGO_EN_EXCESO
  }
  class Comunicacion {
    - id : Long
    - tipo : TipoComunicacion
    - idioma : String
    - estado : ResultadoEnvio
    - fechaSolicitud : FechaHora
    + enviar() : void
    + reenviar(c : Contacto) : void
  }
  enum TipoComunicacion {
    FACTURA
    RECORDATORIO_PREVIO
    RECORDATORIO_VENCIMIENTO
    AVISO_IMPAGO
    DISPUTA_RESUELTA
  }
  class IntentoEnvio {
    - numero : Integer
    - canal : Canal
    - destinatario : String
    - fecha : FechaHora
    - resultado : ResultadoEnvio
    - detalleError : String [0..1]
  }
  enum Canal {
    EMAIL
    WHATSAPP
  }
  enum ResultadoEnvio {
    EN_COLA
    ENVIADO
    ENTREGADO
    REBOTADO
    FALLIDO
  }
  interface CanalEnvio {
    + enviar(i : IntentoEnvio) : ResultadoEnvio
