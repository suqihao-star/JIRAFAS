  class VersionPlantilla {
    - numero : Integer
    - asunto : String
    - contenido : String
    - fecha : FechaHora
    + previsualizar() : String
    + variablesFaltantes() : List<String>
  }
  class SuspensionRecordatorios {
    - motivo : String
    - fechaRevision : Fecha
    - activa : Boolean
    - fechaReanudacion : FechaHora [0..1]
    + reanudar() : void
  }
}

