@startuml turbineh_clases_bloque_B
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 50
skinparam ranksep 65
skinparam shadowing false
skinparam linetype ortho
hide empty members
left to right direction
title TurbineH - UML de clases - Bloque B (revisado)

package "Bloque B - Suscripciones, tarifas y descuentos" {

  class Suscripcion {
    - plan : String
    - precioVigente : Decimal
    - fechaInicio : Fecha
    - estado : String
    - motivoPausa : String
    - fechaInicioPausa : Fecha
    - fechaReactivacionPrevista : Fecha
    - fechaBaja : Fecha
    - motivoBaja : String
    + pausar(motivo : String, reactivacion : Fecha) : void
    + reactivar() : void
    + darDeBaja(fecha : Fecha) : void
    + esFacturable(periodo : String) : Boolean
    + calcularProrrateo(periodo : String) : Decimal
  }
  note right of Suscripcion
    estado: PENDIENTE_ACTIVACION, ACTIVA,
    EN_PAUSA, CANCELADA
  end note

  class RevisionTarifaAnual {
    - fechaRevision : Fecha
    - facturacionAnualVerificada : Decimal
    - precioAnterior : Decimal
    - precioNuevo : Decimal
    - fechaDecision : FechaHora
    - estado : String
    - motivoRechazo : String
    + aprobar() : void
    + rechazar(motivo : String) : void
  }

  class SolicitudDescuento {
    - tipo : String
    - valor : Decimal
    - motivo : String
    - fechaVigencia : Fecha
    - estado : String
    - motivoDecision : String
    - fechaDecision : FechaHora
    + superaUmbral() : Boolean
    + aprobar() : void
    + rechazar(motivo : String) : void
    + escalar() : void
  }
  note right of SolicitudDescuento
    estado: PENDIENTE, ESCALADA, APROBADA,
    APROBADA_CONDICIONADA, RECHAZADA (CU-08, CU-09)
    Si superaUmbral() decide el Superadministrador
    (FR-18, CU-08 FA-3, CU-09)
    Aprobador distinto del solicitante (BR-12)
  end note
}

package "Referencias de otros bloques" #F2F4F8 {
  class Administrador
  class Cliente
  class ExcepcionComercial
  class Factura
  class RangoTarifa
  class UsuarioOperativo
}

Cliente "1" *-- "0..*" Suscripcion
Cliente "1" -- "0..*" RevisionTarifaAnual
RevisionTarifaAnual "0..*" --> "0..1" RangoTarifa : rangoPropuesto
RevisionTarifaAnual "0..*" --> "0..1" Administrador : aprobadaPor
ExcepcionComercial "0..1" -- "0..1" SolicitudDescuento : se aprueba mediante >
SolicitudDescuento "0..*" --> "1" Cliente : para
SolicitudDescuento "0..*" --> "0..1" Suscripcion : sobre
SolicitudDescuento "0..*" --> "1" UsuarioOperativo : solicitante
SolicitudDescuento "0..*" --> "0..1" Administrador : aprobador
Suscripcion "0..1" -- "0..*" Factura : genera >
Factura "0..*" --> "0..1" SolicitudDescuento : descuentoAplicado

legend bottom
Las clases del bloque principal muestran sus atributos y operaciones.
Las referencias externas son las mismas clases definidas en otros bloques.
El fichero global contiene todas las relaciones del sistema.
endlegend
@enduml
