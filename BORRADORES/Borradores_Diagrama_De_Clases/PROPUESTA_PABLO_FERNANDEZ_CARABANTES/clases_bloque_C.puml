@startuml clases_bloque_C
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 60
skinparam ranksep 70
hide empty members
title Diagrama de clases · Bloque C - Facturación\n(las clases grises pertenecen a otro bloque; su detalle está en su diagrama)
skinparam class {
  BackgroundColor<<otroBloque>> #EEEEEE
  BorderColor<<otroBloque>> #999999
  FontColor<<otroBloque>> #777777
}
hide <<otroBloque>> stereotype
hide <<otroBloque>> members

package "Bloque C - Facturación" {

  class Factura {
    - numero : String
    - tipo : String
    - estado : String
    - fechaEmision : Fecha
    - fechaVencimiento : Fecha
    - periodoFacturado : String
    - moneda : String
    - baseImponible : Decimal
    - total : Decimal
    - saldoPendiente : Decimal
    - retenida : Boolean
    - motivoRetencion : String
    - documentoPDF : Archivo
    - migrada : Boolean
    + calcularTotales() : void
    + validarDatosFiscales() : Boolean
    + emitir() : void
    + generarPDF() : void
    + anular(motivo : String) : void
  }
  note right of Factura
    estado: BORRADOR, APROBADA, EMITIDA, ENVIADA,
    VENCIDA, PAGADA, PARCIALMENTE_CONCILIADA,
    ANULADA, RECTIFICADA (FR-19),
    INCOBRABLE, CANCELADA (FR-19, CU-14)
    retenida = pendiente de CU-13 (FR-13)
    Emitida = inmutable (BR-09)
  end note

  class FacturaRectificativa {
    - motivoRectificacion : String
  }

  class LineaFactura {
    - concepto : String
    - cantidad : Decimal
    - precioUnitario : Decimal
    - descuento : Decimal
    - porcentajeImpuesto : Decimal
    - importe : Decimal
    + calcularImporte() : Decimal
  }

  class FiltroGuardado {
    - nombre : String
    - criterios : String
    + aplicar() : void
  }

  class OperacionExcepcional {
    - tipo : String
    - motivo : String
    - estado : String
    + aprobar() : void
    + ejecutar() : void
  }
  note bottom of OperacionExcepcional
    tipo: RECTIFICACION, ANULACION,
    INCOBRABLE, CANCELACION (CU-14)
  end note
}

class Suscripcion <<otroBloque>>
class Cliente <<otroBloque>>
class Impuesto <<otroBloque>>
class SerieFacturacion <<otroBloque>>
abstract class Usuario <<otroBloque>>
class Administrador <<otroBloque>>
class SolicitudDescuento <<otroBloque>>
class Conciliacion <<otroBloque>>
class Comunicacion <<otroBloque>>
class SuspensionRecordatorios <<otroBloque>>
class Incidencia <<otroBloque>>
class CentroCoste <<otroBloque>>

Factura <|-- FacturaRectificativa
Suscripcion "0..1" -- "0..*" Factura : genera >
Cliente "1" -- "0..*" Factura
Factura "1" *-- "1..*" LineaFactura
LineaFactura "0..*" --> "1" Impuesto
SerieFacturacion "1" -- "0..*" Factura : numera >
FacturaRectificativa "0..*" --> "1" Factura : rectificaA
Factura "0..*" --> "1" Usuario : creadaPor
Factura "0..*" --> "0..1" Administrador : aprobadaPor
Factura "1" -- "0..*" OperacionExcepcional
OperacionExcepcional "0..*" --> "1" Administrador : solicitante
OperacionExcepcional "0..*" --> "0..1" Administrador : aprobador
Factura "0..*" --> "0..1" SolicitudDescuento : descuentoAplicado
Usuario "1" *-- "0..*" FiltroGuardado
Factura "1" -- "0..*" Conciliacion
Factura "0..1" -- "0..*" Comunicacion
Factura "1" -- "0..*" SuspensionRecordatorios
Factura "0..1" -- "0..*" Incidencia
Factura "0..*" --> "0..1" CentroCoste
@enduml
